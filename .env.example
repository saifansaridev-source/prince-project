# Server Configuration
PORT=3000
SESSION_SECRET=change-this-to-a-secure-random-secret-key

# MongoDB Database URI
MONGODB_URI=mongodb://127.0.0.1:27017/ghar_bazaar

# SMTP Email Configuration (Optional: If empty, email OTPs are printed to server console in demo mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=noreply@gharbazaar.com

# Cloudinary Configuration (For Property Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth Sign-In (For Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
